#include <iostream>
using namespace std;
class company{
    private:
    string name;
    int age;
    int id;
    float salary;
    public:
    void setinfo(string n,int a,int id,float s){
        this->name=n;
        this->age=a;
        this->id=id;
        this->salary=s;
    }
    void getinfo(){
        cout<<endl<<"Enter employee name-->";
        cin>>name;
        cout<<"Enter employee ID-->";
        cin>>id;
        cout<<"Enter employee age-->";
        cin>>age;
        cout<<"Enter employee salary-->";
        cin>>salary;
    }
    void outinfo(){
        cout<<endl<<endl<<"Employee name-->"<<name;
        cout<<endl<<"Employee ID-->"<<id;
        cout<<endl<<"Employee age-->"<<age;
        cout<<endl<<"Employee salary-->"<<salary;
    }
};
int main() {
    int num;
    cout<<"Enter how many employee-->";
    cin>>num;
    company c[num]; 
    for(int i=0;i<num;i++){
        cout<<endl<<endl<<"Employee"<<i+1;
       c[i].getinfo();
     }
     for(int i=0;i<num;i++){
         cout<<endl<<endl<<"Employee"<<i+1;
         c[i].outinfo();
     }
    return 0;
}
