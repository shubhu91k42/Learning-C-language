class project_1{
    private:
    int num;
    char choice;
    public:
    void project1(int n,char c){
        this->num=n;
        this->choice=c;
    }
    
    void getproject1(){
        cout<<endl<<endl<<"===Find Even or Odd==="<<endl<<endl;
        for(;;){
        cout<<endl<<"Enter a number-->";
        cin>>num;
        if(num==0){
            cout<<num<<" is neither odd nor even"<<endl;
        }else if(num%2==0){
            cout<<num<<" is an even number"<<endl;
        }else if(num%2!=0){
            cout<<num<<" is an odd number"<<endl;
        }else{
            break;
        }
    for(;;){
       cout<<endl<<"Do you want to do more(Y/N)-->";
       cin>>choice;
       if(choice=='n'||choice=='N'){
           cout<<endl<<"Tank you :)";
           return;
       }else if(choice=='y'||choice=='Y'){
           break;
       }else{
           cout << "Invalid input! Only enter Y or N." << endl;
           
       }
    }
     }
    }
};

