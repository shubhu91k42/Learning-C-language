#include <iostream>
#include <string>
#include <limits>
#include <vector>
using namespace std;

class student{
    private:
    string name;
    int age=0;
    int roll=0;
    float english_marks=0;
    float hindi_marks=0;
    float marathi_marks=0;
    float maths_marks=0;
    float science_marks=0;
    float per=0;
    char grade;
    public:
    void studentdetails(){
        cout<<"\nEnter student name-->";
        getline(cin>>ws,name);
        cout<<"Enter student age-->";
        while(!(cin>>age)){
            cout<<"Invalid input. Please enter a valid age: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        cout<<"Enter student roll number-->";
        while(!(cin>>roll)){
            cout<<"Invalid input. Please enter a valid roll number: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        cout<<"Enter English marks-->";
        while(!(cin>>english_marks)){
            cout<<"Invalid input. Please enter a valid English marks: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        cout<<"Enter Hindi marks-->";
        while(!(cin>>hindi_marks)){
            cout<<"Invalid input. Please enter a valid Hindi marks: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        cout<<"Enter Marathi marks-->";
        while(!(cin>>marathi_marks)){
            cout<<"Invalid input. Please enter a valid Marathi marks: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        cout<<"Enter Maths marks-->";
        while(!(cin>>maths_marks)){
            cout<<"Invalid input. Please enter a valid Maths marks: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        cout<<"Enter Science marks-->";
        while(!(cin>>science_marks)){
            cout<<"Invalid input. Please enter a valid Science marks: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
    }
    float studentpercentage(){
        per=((english_marks+hindi_marks+marathi_marks+maths_marks+science_marks)/500)*100;
        return per;
    }
    bool isstudentpass(){
        if(english_marks>40&&
           hindi_marks>40&&
           marathi_marks>40&&
           maths_marks>40&&
           science_marks>40){
            return true;
        }else{
            return false;
        }
    }
    char studentgrade(){
        if (isstudentpass()) {
            if (per >= 90)
                grade = 'A';
            else if (per >= 80)
                grade = 'B';
            else if (per >= 70)
                grade = 'C';
            else if (per >= 60)
                grade = 'D';
            else if (per >= 40)
                grade = 'E';
        } 
        else if(!isstudentpass()) {
            grade = 'F';
        }

        return grade;
    }
    void studentdisplay(){
        cout<<"*-------------------------------------------------*"<<endl;
        cout<<"Student name-->"<<name<<endl;
        cout<<"Student age-->"<<age<<endl;
        cout<<"Student roll number-->"<<roll<<endl;
        cout<<"-------------------------------------------------"<<endl;
        cout<<"English marks-->"<<english_marks<<endl;
        cout<<"Hindi marks-->"<<hindi_marks<<endl;
        cout<<"Marathi marks-->"<<marathi_marks<<endl;
        cout<<"Maths marks-->"<<maths_marks<<endl;
        cout<<"Science marks-->"<<science_marks<<endl;
        cout<<"-------------------------------------------------"<<endl;
        cout<<"Student percentage-->"<<per<<"%"<<endl;
        cout<<"Student grade-->"<<grade<<endl;
        cout<<"*-------------------------------------------------*"<<endl;
    }
        float getpercentage() {
        return per;
    }

    string getname() {
        return name;
    }
};
int main(){
    int n;
    cout<<"Enter how many student data to add-->";
    cin>>n;
    vector <student> s(n);
    cout<<"\n--Student data--\n";
    for(int i=0;i<n;i++){
        cout<<"\nStudent "<<i+1<<endl;
        s[i].studentdetails();
        s[i].studentpercentage();
        s[i].isstudentpass();
        s[i].studentgrade();
    }
    cout<<"\n--Student detials--\n";
        for(int i=0;i<n;i++){
        cout<<"\nStudent "<<i+1<<endl;
        s[i].studentdisplay();
    }
    int top=0;
    for(int i=1;i<n;i++){
        if(s[i].getpercentage()>s[top].getpercentage()){
            top=i;
        }
    }
    cout<<"\n--Topper--\n";
    s[top].studentdisplay();
}
