#include <iostream>
#include <string>
#include <limits>
#include <vector>
using namespace std;

class student{
    private:
    string name;
    int age=0;
    int roll=0;
    float english_marks=0;
    float physics_marks=0;
    float chemistry_marks=0;
    float maths_marks=0;
    float IT_marks=0;
    float per=0;
    char grade;
    public:
    void studentdetails(){
        cout<<"\nEnter student name-->";
        getline(cin>>ws,name);
        cout<<"Enter student age-->";
        cin>>age;
        cout<<"Enter student roll number-->";
        cin>>roll;
        cout<<"Enter English marks-->";
        cin>>english_marks;
        cout<<"Enter Physics marks-->";
        cin>>physics_marks;
        cout<<"Enter Chemistry marks-->";
        cin>>chemistry_marks;
        cout<<"Enter Maths marks-->";
        cin>>maths_marks;
        cout<<"Enter IT marks-->";
        cin>>IT_marks;
    }
    float studentpercentage(){
        per=((english_marks+physics_marks+chemistry_marks+maths_marks+IT_marks)/500)*100;
        return per;
    }
    bool isstudentpass(){
        if(english_marks>40&&
           physics_marks>40&&
           chemistry_marks>40&&
           maths_marks>40&&
           IT_marks>40){
            return true;
        }else{
            return false;
        }
    }
    char studentgrade(){
        if (isstudentpass()) {
            if (per >= 90)
                grade = 'A';
            else if (per >= 80)
                grade = 'B';
            else if (per >= 70)
                grade = 'C';
            else if (per >= 60)
                grade = 'D';
            else if (per >= 40)
                grade = 'E';
        } 
        else if(!isstudentpass()) {
            grade = 'F';
        }

        return grade;
    }
    void studentdisplay(){
        cout<<"*-------------------------------------------------*"<<endl;
        cout<<"Student name-->"<<name<<endl;
        cout<<"Student age-->"<<age<<endl;
        cout<<"Student roll number-->"<<roll<<endl;
        cout<<"-------------------------------------------------"<<endl;
        cout<<"English marks-->"<<english_marks<<endl;
        cout<<"Physics marks-->"<<physics_marks<<endl;
        cout<<"Chemistry marks-->"<<chemistry_marks<<endl;
        cout<<"Maths marks-->"<<maths_marks<<endl;
        cout<<"IT marks-->"<<IT_marks<<endl;
        cout<<"-------------------------------------------------"<<endl;
        cout<<"Student percentage-->"<<per<<"%"<<endl;
        cout<<"Student grade-->"<<grade<<endl;
        cout<<"*-------------------------------------------------*"<<endl;
    }
};
int main(){
    int n;
    cout<<"Enter how many student data to add-->";
    cin>>n;
    vector <student> s(n);
    cout<<"\n--Student data--\n";
    for(int i=0;i<n;i++){
        cout<<"\nStudent "<<i+1<<endl;
        s[i].studentdetails();
        s[i].studentpercentage();
        s[i].isstudentpass();
        s[i].studentgrade();
    }
    cout<<"\n--Student detials--\n";
        for(int i=0;i<n;i++){
        cout<<"\nStudent "<<i+1<<endl;
        s[i].studentdisplay();
    }
    int top=0;
    for(int i=1;i<n;i++){
        if(s[i].studentpercentage()>s[top].studentpercentage()){
            top=i;
        }
    }
    cout<<"\n--Topper--\n";
    s[top].studentdisplay();
}
