class oddandeven{
    private:
    int num;
    public:
    void getnumber(){
        cout<<"Enter a number-->";
        while(!(cin>>num)){
            cout<<"Invalid input. Please enter a valid number: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
    }
    void checkevenodd(){
        if(num%2==0){
            cout<<num<<" is an even number."<<endl;
        }else{
            cout<<num<<" is an odd number."<<endl;
        }
    }
};
class addtion{
    private:
    float num,answer,n;
    public:
    void getnumbers(){
        cout<<"Enter the number of elements to add-->";
        while(!(cin>>n)){
            cout<<"Invalid input. Please enter a valid number: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        answer=0;
        for(int i=1;i<=n;i++){
            cout<<"Enter number "<<i<<"-->";
            while(!(cin>>num)){
                cout<<"Invalid input. Please enter a valid number: ";
                cin.clear();
                cin.ignore(numeric_limits<streamsize>::max(), '\n');
            }
            answer+=num;
        }
        cout<<"The sum of the numbers is: "<<answer<<endl;
    }
};
class subtraction{
    private:
    float num,answer,n;
    public:
    void getnumbers(){
        cout<<"Enter the number of elements to subtract-->";
        while(!(cin>>n)){
            cout<<"Invalid input. Please enter a valid number: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        answer=0;
        for(int i=1;i<=n;i++){
            cout<<"Enter number "<<i<<"-->";
            while(!(cin>>num)){
                cout<<"Invalid input. Please enter a valid number: ";
                cin.clear();
                cin.ignore(numeric_limits<streamsize>::max(), '\n');
            }
            if(i==1){
                answer=num;
            }else{
                answer-=num;
            }
        }
        cout<<"The result of the subtraction is: "<<answer<<endl;
    }
};
