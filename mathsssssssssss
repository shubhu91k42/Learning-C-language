class division{
    private:
    float num,answer,n;
    public:
    void getnumbers(){
        cout<<"Enter the number of elements to divide-->";
        while(!(cin>>n)){
            cout<<"Invalid input. Please enter a valid number: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
        answer=0;
        for(int i=1;i<=n;i++){
            cout<<"Enter number "<<i<<"-->";
            while(!(cin>>num)){
                cout<<"Invalid input. Please enter a valid number: ";
                cin.clear();
                cin.ignore(numeric_limits<streamsize>::max(), '\n');
            }
            if(i==1){
                answer=num;
            }else{
                if(num==0){
                    cout<<"Division by zero is not allowed. Please enter a non-zero number."<<endl;
                    i--;
                    continue;
                }
                answer/=num;
            }
        }
        cout<<"The result of the division is: "<<answer<<endl;
    }
};
class square{
    private:
