#include <iostream>
#include <string>
#include <math.h>
using namespace std;

class oddeven{
    private:
    int num;
    public:
    void getnum(){
        cout<<"Enter a number-->";
        cin>>num;
    }
    void checkevenodd(){
        if(num%2==0){
            cout<<num<<" is an even number."<<endl;
        }else{
            cout<<num<<" is an odd number."<<endl;
        }
    }
};
class square{
    private:
    int num;
    public:
    void getnum(){
        cout<<"Enter a number-->";
        cin>>num;
    }
    void calculatesquare(){
        cout<<num<<" squared is "<<num*num<<endl;
    }
};
class prime{
    private:
    int num,r=0;
    public:
    void getnum(){
        cout<<"Enter a number-->";
        cin>>num;
    }
    void checkprime(){
        bool isprime=true;
        if(num<=1){
            isprime=false;
        }
        for(int i=2; i<num; i++){
            if(num%i==0){
                isprime=false;
                break;
            }
        }
        if(isprime){
            cout<<num<<" is a prime number."<<endl;
        }else{
            cout<<num<<" is not a prime number."<<endl;
            cout<<"The factors of "<<num<<" are: ";
            for(int i=1; i<=num; i++){
                if(num%i==0){
                    cout<<i<<"X"<<num/i<<"="<<num<<endl;
                }
            }
            cout<<endl;
        }
    }
};
class addition{
    private:
    int num,sum=0;
    public:
    void getnumbers(){
        cout<<"Enter how many numbers you want to add-->";
        cin>>num;
        for(int i=1;i<=num;i++){
            int n;
            cout<<"Enter number "<<i<<"-->";
            cin>>n;
            sum+=n;
        }
        cout<<"The sum of "<<num<<" numbers is "<<sum<<endl;
    }
};
class subtraction{
    private:
    int num,diff=0;
    public:
    void getnumbers(){
        cout<<"Enter how many numbers you want to subtract-->";
        cin>>num;
        for(int i=1;i<=num;i++){
            int n;
            cout<<"Enter number "<<i<<"-->";
            cin>>n;
            if(i==1){
                diff=n;
            }else{
                diff-=n;
            }
        }
        cout<<"The difference of "<<num<<" numbers is "<<diff<<endl;
    }
};
class multiplication{
    private:
    int num,product=1;
    public:
    void getnumbers(){
        cout<<"Enter how many numbers you want to multiply-->";
        cin>>num;
        for(int i=1;i<=num;i++){
            int n;
            cout<<"Enter number "<<i<<"-->";
            cin>>n;
            product*=n;
        }
        cout<<"The product of "<<num<<" numbers is "<<product<<endl;
    }
};
class division{
    private:
    int num;
    float quotient=0;
    public:
    void getnumbers(){
        cout<<"Enter how many numbers you want to divide-->";
        cin>>num;
        for(int i=1;i<=num;i++){
            float n;
            cout<<"Enter number "<<i<<"-->";
            cin>>n;
            if(i==1){
                quotient=n;
            }else{
                quotient/=n;
            }
        }
        cout<<"The quotient of "<<num<<" numbers is "<<quotient<<endl;
    }
};
class fibonacci{
    private:
    int num,first=0,second=1,next;
    public:
    void getnum(){
        cout<<"Enter how many terms of Fibonacci series you want to print-->";
        cin>>num;
    }
    void printfibonacci(){
        for(int i=1;i<=num;i++){
            next=first+second;
            cout<<first<<"+"<<second<<"="<<next<<endl;
            first=second;
            second=next;
        }
    }
};
class table{
    private:
    int num;
    public:
    void getnum(){
        cout<<"Enter a number-->";
        cin>>num;
    }
    void printtable(){
        cout<<"Multiplication table of "<<num<<":"<<endl;
        for(int i=1;i<=10;i++){
            cout<<num<<" x "<<i<<" = "<<num*i<<endl;
        }
    }
};
int main(){
    oddeven o;
    square sq;
    prime p;
    addition a;
    subtraction s;
    multiplication m;
    division d;
    fibonacci f;
    table t;
    int choice;
    do{
        cout<<"\n1. Check Odd/Even\n2. Get Square\n3. Check Prime\n4. Addition\n5. Subtraction\n6. Multiplication\n7. Division\n8. Fibonacci Series\n9. Multiplication Table\n10. Exit"<<endl;
        cout<<"Enter your choice-->";
        cin>>choice;
        switch(choice){
            case 1:
                o.getnum();
                o.checkevenodd();
                break;
            case 2:
                sq.getnum();
                sq.calculatesquare();
                break;
            case 3:
                p.getnum();
                p.checkprime();
                break;
            case 4:
                a.getnumbers();
                break;
            case 5:
                s.getnumbers();
                break;
            case 6:
                m.getnumbers();
                break;
            case 7:
                d.getnumbers();
                break;
            case 8:
                f.getnum();
                f.printfibonacci();
                break;
            case 9:
                t.getnum();
                t.printtable();
                break;
            case 10:
                cout<<"Exiting..."<<endl;
                break;
            default:
                cout<<"Invalid choice! Please try again."<<endl;
        }
    }while(choice!=10);
    return 0;
}
