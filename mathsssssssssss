class oe{
    private:
    int num;
    public:
    void getinfo(){
        cout<<"Enter a number-->";
        cin>>num;
        if(num%2==0){
            cout<<num<<" is even number";
        }else if(num%2!=0){
            cout<<num<<" is odd number";
        }else{
            cout<<num<<" is not odd or even";
        }
    }
};
