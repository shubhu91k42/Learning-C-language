#include <iostream>
#include <string>
#include <math.h>
using namespace std;

class oddeven{
    private:
    int num;
    public:
    void getnum(){
        cout<<"Enter a number-->";
        cin>>num;
    }
    void checkevenodd(){
        if(num%2==0){
            cout<<num<<" is an even number."<<endl;
        }else{
            cout<<num<<" is an odd number."<<endl;
        }
    }
};
class prime{
    private:
    int num;
    public:
    void getnum(){
        cout<<"Enter a number-->";
        cin>>num;
    }
    void checkprime(){
        if(num <= 1){
            cout<<num<<" is not a prime number."<<endl;
            return;
        }
        for(int i=2; i*i<=num; i++){
            if(num % i == 0){
                cout<<num<<" is not a prime number."<<endl;
                return; 
            }
        }
        cout<<num<<" is a prime number."<<endl;
    }
};
class addition{
    private:
    int num,sum=0;
    public:
    void getnumbers(){
        cout<<"Enter how many numbers you want to add-->";
        cin>>num;
        for(int i=1;i<=num;i++){
            int n;
            cout<<"Enter number "<<i<<"-->";
            cin>>n;
            sum+=n;
        }
        cout<<"The sum of "<<num<<" numbers is "<<sum<<endl;
    }
};
class subtraction{
    private:
    int num,diff=0;
    public:
    void getnumbers(){
        cout<<"Enter how many numbers you want to subtract-->";
        cin>>num;
        for(int i=1;i<=num;i++){
            int n;
            cout<<"Enter number "<<i<<"-->";
            cin>>n;
            if(i==1){
                diff=n;
            }else{
                diff-=n;
            }
        }
        cout<<"The difference of "<<num<<" numbers is "<<diff<<endl;
    }
};
class multiplication{
    private:
    int num,product=1;
    public:
    void getnumbers(){
        cout<<"Enter how many numbers you want to multiply-->";
        cin>>num;
        for(int i=1;i<=num;i++){
            int n;
            cout<<"Enter number "<<i<<"-->";
            cin>>n;
            product*=n;
        }
        cout<<"The product of "<<num<<" numbers is "<<product<<endl;
    }
};
class division{
    private:
    int num;
    float quotient=0;
    public:
    void getnumbers(){
        cout<<"Enter how many numbers you want to divide-->";
        cin>>num;
        for(int i=1;i<=num;i++){
            float n;
            cout<<"Enter number "<<i<<"-->";
            cin>>n;
            if(i==1){
                quotient=n;
            }else{
                quotient/=n;
            }
        }
        cout<<"The quotient of "<<num<<" numbers is "<<quotient<<endl;
    }
};
class fiboonacci{
    private:
    int num,first=0,second=1,next;
    public:
    void getnum(){
        cout<<"Enter how many terms of Fibonacci series you want to print-->";
        cin>>num;
    }
    void printfibonacci(){
        for(int i=1;i<=num;i++){
            next=first+second;
            cout<<first<<"+"<<second<<"="<<next<<endl;
            first=second;
            second=next;
        }
    }
};
class table{
    private:
    int num;
    public:
    void getnum(){
        cout<<"Enter a number-->";
        cin>>num;
    }
    void printtable(){
        cout<<"Multiplication table of "<<num<<":"<<endl;
        for(int i=1;i<=10;i++){
            cout<<num<<" x "<<i<<" = "<<num*i<<endl;
        }
    }
};
int main(){
    oddeven o;
    prime p;
    addition a;
    subtraction s;
    multiplication m;
    division d;
    fiboonacci f;
    table t;
    int choice;
    do{
        cout<<"\n1. Check Odd/Even\n2. Check Prime\n3. Addition\n4. Subtraction\n5. Multiplication\n6. Division\n7. Fibonacci Series\n8. Multiplication Table\n9. Exit"<<endl;
        cout<<"Enter your choice-->";
        cin>>choice;
        switch(choice){
            case 1:
                o.getnum();
                o.checkevenodd();
                break;
            case 2:
                p.getnum();
                p.checkprime();
                break;
            case 3:
                a.getnumbers();
                break;
            case 4:
                s.getnumbers();
                break;
            case 5:
                m.getnumbers();
                break;
            case 6:
                d.getnumbers();
                break;
            case 7:
                f.getnum();
                f.printfibonacci();
                break;
            case 8:
                t.getnum();
                t.printtable();
                break;
            case 9:
                cout<<"Exiting..."<<endl;
                break;
            default:
                cout<<"Invalid choice! Please try again."<<endl;
        }
    }while(choice!=9);
    return 0;
}
